#!/usr/bin/env bash
set -euo pipefail

# Format all Nix files before commit
nix --extra-experimental-features 'nix-command flakes' fmt .

# Fail if formatter changed anything (re-stage and recommit)
if ! git diff --quiet; then
  echo ""
  echo "  nix fmt made changes. Review, re-stage, and recommit:"
  git diff --stat | sed 's/^/  /'
  echo ""
  exit 1
fi

# Plugins fail silently, so a bad name has to be caught before it lands.
if git diff --cached --name-only | grep -qE '(plugins\.nix|roles/[^/]+/ai/default\.nix)$'; then
  ./scripts/verify-plugins.sh --quiet
fi

# A dangling reference is ignored at deploy time, so catch it here.
./scripts/verify-references.sh --quiet

prefix_rule(pattern=["git", ["status", "diff", "log", "show", "branch", "fetch", "blame", "rev-parse", "ls-files"]], decision="allow", match=["git status", "git diff --stat"], not_match=["git push"])
prefix_rule(pattern=["pnpm", ["install", "test", "lint", "typecheck", "build", "format", "check"]], decision="allow", match=["pnpm install", "pnpm test"])
prefix_rule(pattern=["pnpm", "run", ["test", "lint", "typecheck", "build", "check"]], decision="allow")
prefix_rule(pattern=["nix", "fmt"], decision="allow")
prefix_rule(pattern=["nix", "flake", ["check", "show", "metadata"]], decision="allow")
prefix_rule(pattern=["nix", "build"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["fd"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["gh", "pr", ["view", "checks", "diff", "list"]], decision="allow")
prefix_rule(pattern=["gh", "run", ["list", "view"]], decision="allow")
prefix_rule(pattern=["doppler", "run", "--", "pnpm", ["dev", "test", "build", "lint", "typecheck"]], decision="allow", match=["doppler run -- pnpm dev"], not_match=["doppler run -- pnpm dlx x"])
prefix_rule(pattern=["rm", ["-rf", "-fr", "-r", "-R"]], decision="prompt", justification="Recursive delete")
prefix_rule(pattern=["git", "reset", "--hard"], decision="prompt", justification="Discards work")
prefix_rule(pattern=["git", "clean"], decision="prompt")
prefix_rule(pattern=["git", "push", ["--force", "-f", "--force-with-lease"]], decision="forbidden", justification="Force push needs the user")
prefix_rule(pattern=["git", "checkout", "--", "."], decision="prompt")
prefix_rule(pattern=["ssh"], decision="prompt", justification="Remote command, ask first")
prefix_rule(pattern=["scp"], decision="prompt")
prefix_rule(pattern=["rsync"], decision="prompt")
prefix_rule(pattern=["doppler", "secrets"], decision="forbidden", justification="Never read secret values")
prefix_rule(pattern=["terraform", ["apply", "destroy"]], decision="prompt")
prefix_rule(pattern=["env"], decision="prompt")
prefix_rule(pattern=["printenv"], decision="prompt")

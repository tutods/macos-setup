{
  config,
  lib,
  aiLib,
  pkgs,
  ...
}: let
  tomlq = "${pkgs.yq}/bin/tomlq";
  autoProfileJson = pkgs.writeText "codex-auto-profile.json" (builtins.toJSON {
    check_for_update_on_startup = false;
    approval_policy = "on-request";
    sandbox_mode = "workspace-write";
    approvals_reviewer = "auto_review";
    sandbox_workspace_write.network_access = true;
  });

  sources = config.home.ai.codexSkillSources;

  agentsMd = aiLib.appendIfNonEmpty (''
      # Codex global instructions

      Generated by the dotfiles repo from home/roles/personal/ai and the shared sources in home/common/ai/instructions. Hand edits are lost on the next deploy; change the repo.

    ''
    + builtins.readFile ./codex.md
    + "\n\n"
    + builtins.readFile ../../../common/ai/instructions/shared.md)
  config.home.ai.extraInstructions;
in {
  home.file.".codex/AGENTS.md".text = agentsMd;

  # Codex itself appends approved commands to rules/default.rules, so that file stays unmanaged.
  home.file.".codex/rules/nix.rules".source = ./codex.rules;

  # https://learn.chatgpt.com/docs/config-file/config-advanced: profiles are top-level keys in ~/.codex/<name>.config.toml.
  # Codex writes TUI choices (model, ...) into the active profile file, so it is a writable merged copy, never a store symlink.
  home.activation.codexAutoProfile = lib.hm.dag.entryAfter ["writeBoundary"] ''
    target="$HOME/.codex/auto.config.toml"
    run mkdir -p "$(dirname "$target")"
    merged=$(mktemp)
    if [ -e "$target" ]; then
      if ! ${tomlq} -t --slurpfile vw ${autoProfileJson} '. * $vw[0]' "$target" > "$merged"; then
        echo "codex: merge into $target failed, fix or remove the file" >&2
        rm -f "$merged"
        exit 1
      fi
    else
      ${tomlq} -t -n --slurpfile vw ${autoProfileJson} '$vw[0]' > "$merged"
    fi
    [ -L "$target" ] && run rm -f "$target"
    run install -m 0600 "$merged" "$target"
    rm -f "$merged"
  '';

  programs.fish.functions.codex = {
    description = "codex with the auto profile unless --profile or -p is given";
    body = ''
      for a in $argv
        switch $a
          case --profile '--profile=*' -p
            command codex $argv
            return
        end
      end
      command codex --profile auto $argv
    '';
  };

  # ~/.agents/skills is Codex's user skill dir; ~/.codex/skills holds Codex's own .system and must stay untouched.
  # The dir is shared with Orca and `npx skills` installs, so a manifest records which names this repo owns.
  home.activation.codexSkills = lib.hm.dag.entryAfter ["writeBoundary" "linkGeneration"] ''
    dest="$HOME/.agents/skills"
    manifest="$HOME/.agents/.dotfiles-managed-skills"
    declared=" ${lib.concatStringsSep " " (lib.attrNames sources)} "
    run mkdir -p "$dest"

    old=""
    [ -f "$manifest" ] && old=$(cat "$manifest")

    for name in $old; do
      case "$declared" in
        *" $name "*) ;;
        *) run rm -rf "$dest/$name" ;;
      esac
    done

    new=""
    ${lib.concatStringsSep "\n" (lib.mapAttrsToList (name: src: ''
        if { [ -e "$dest/${name}" ] || [ -L "$dest/${name}" ]; } && ! printf '%s\n' "$old" | grep -qx "${name}"; then
          echo "  ⚠  ~/.agents/skills/${name} exists and is not managed here, skipped" >&2
        else
          run rm -rf "$dest/${name}"
          run cp -R "${src}" "$dest/${name}"
          run chmod -R u+w "$dest/${name}"
          new="$new ${name}"
        fi
      '')
      sources)}

    tmp=$(mktemp)
    printf '%s\n' $new > "$tmp"
    run install -m 0644 "$tmp" "$manifest"
    rm -f "$tmp"
    echo "↣ Codex skills: $(set -- $new; echo $#) installed"
  '';
}
